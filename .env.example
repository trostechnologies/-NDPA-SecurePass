# Supabase/PostgreSQL only. No SQLite fallback.
# Copy to a private environment file; never commit credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=8181
SECUREPASS_ORIGIN=https://securepass.trostechnologies.com
SECUREPASS_COOKIE_SECURE=true
TRUST_PROXY=1
SECUREPASS_DEPLOYMENT_MODE=isolated
SECUREPASS_SITES_FILE=/etc/securepass/sites.json
SECUREPASS_SECRETS_FILE=/etc/securepass/secrets.json
SECUREPASS_DATABASE_FILE=/etc/securepass/database.json
SECUREPASS_DATA_DIR=/var/lib/securepass-state
SECUREPASS_JOURNAL_DIR=/var/lib/securepass-journal
SECUREPASS_BACKUP_DIR=/var/lib/securepass-backups
SECUREPASS_AUDIT_ARCHIVE_DIR=/var/lib/securepass-audit-archives
SECUREPASS_BACKUP_POLICY_ACK=true
SECUREPASS_MFA_REQUIRED=admin
SECUREPASS_GATE_ENABLED=false
SECUREPASS_MAX_RECORDS=10000
SECUREPASS_MAX_AUDITS=50000
# Database fields may instead come from the private database.json:
# PGHOST=aws-0-eu-west-1.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=securepass_runtime.tyfpwyulwoufimjtfjtv
# PGPASSWORD=SET_PRIVATELY_ON_THE_VPS
# Optional trusted CA downloaded from the project dashboard:
# PGSSLROOTCERT=/etc/securepass/supabase-ca.crt
