# Copy to .env locally, but use your process manager to supply environment variables.
# NEVER commit actual credentials. First boot requires a strong initial password.
SECUREPASS_ADMIN_EMAIL=admin@example.org
SECUREPASS_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_24_PLUS_CHAR_SECRET
SECUREPASS_ORIGIN=http://localhost:3000
# For development HTTP only. Production must use HTTPS and Secure cookies.
SECUREPASS_COOKIE_SECURE=false
SECUREPASS_DATA_DIR=./securepass-data
HOST=127.0.0.1
PORT=8080

# Required reviewed configuration in production. Never put secrets in the privacy notice.
SECUREPASS_CONTROLLER_NAME=Development controller
SECUREPASS_FACILITY_NAME=Development facility
SECUREPASS_PRIVACY_EMAIL=privacy@example.org
SECUREPASS_NOTICE_VERSION=development-1
SECUREPASS_NOTICE_TEXT=Development only. Obtain the facility approved privacy notice before collecting real personal data.
SECUREPASS_RETENTION_DAYS=60
SECUREPASS_MAX_RECORDS=10000
SECUREPASS_MAX_AUDITS=50000
