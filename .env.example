# Local development only. Copy to .env, replace the password, and keep it private.
SECUREPASS_ADMIN_EMAIL=admin@example.org
SECUREPASS_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_24_PLUS_CHAR_SECRET
SECUREPASS_ORIGIN=http://localhost:3000
SECUREPASS_COOKIE_SECURE=false
HOST=127.0.0.1
PORT=8080

# One codebase supports isolated and shared deployment. Shared mode requires a registry.
SECUREPASS_DEPLOYMENT_MODE=isolated
SECUREPASS_TENANT_ID=example-org
SECUREPASS_SITE_ID=main
SECUREPASS_SITE_KEY=main
# SECUREPASS_SITES_FILE=./.private/sites.json

SECUREPASS_DATA_DIR=./securepass-data
SECUREPASS_JOURNAL_DIR=./securepass-privacy-journal
SECUREPASS_BACKUP_DIR=./securepass-backups
SECUREPASS_AUDIT_ARCHIVE_DIR=./securepass-audit-archives
# Explicit legacy assignment when migrating directly into shared mode:
# SECUREPASS_MIGRATION_SITE=customer-a-lagos
# Development plaintext-to-encrypted migration is explicit; never use this to replace lost keys.
# SECUREPASS_ALLOW_LEGACY_MIGRATION=true

SECUREPASS_CONTROLLER_NAME=Development controller
SECUREPASS_FACILITY_NAME=Development facility
SECUREPASS_PRIVACY_EMAIL=privacy@example.org
SECUREPASS_NOTICE_VERSION=development-1
SECUREPASS_NOTICE_TEXT=Development only. Replace with the controller-approved privacy notice before collecting real personal data.
SECUREPASS_RETENTION_DAYS=60
SECUREPASS_BACKUP_RETENTION_DAYS=7
SECUREPASS_MFA_REQUIRED=admin
SECUREPASS_SESSION_MINUTES=480
SECUREPASS_PUBLIC_DIRECTORY=false
SECUREPASS_MAX_RECORDS=10000
SECUREPASS_MAX_AUDITS=50000
SECUREPASS_PROOF_DIFFICULTY=3

# Gates remain disabled until a site-bound device registry is provisioned and tested.
SECUREPASS_GATE_ENABLED=false
SECUREPASS_PASS_HOURS=12
# SECUREPASS_GATE_DEVICES_FILE=./.private/gate-devices.json

# Production: use the Compose secret file and independent persistent volumes.
# SECUREPASS_SECRETS_FILE=/run/secrets/credentials
# SECUREPASS_BACKUP_POLICY_ACK=true
# TRUST_PROXY=1
# Production keys are generated by ops/bootstrap.mjs; never put real keys in this file.
