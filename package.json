  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev:server": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "ops": "node --env-file-if-exists=.env ops/manage.mjs",
    "db": "node --env-file-if-exists=.env ops/database.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1"
